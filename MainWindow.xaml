<Window x:Class="Orbiq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbiq" Width="68" Height="68"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Grid x:Name="RootGrid" ClipToBounds="False">
        <Border x:Name="Bubble" Width="60" Height="60" CornerRadius="30"
                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                Background="{DynamicResource BubbleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.2"
                Cursor="Hand" MouseLeftButtonUp="Bubble_MouseLeftButtonUp"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid x:Name="BubbleContentGrid" ClipToBounds="True">
                <Image x:Name="BubbleGlyph" Source="/Orbiq;component/Assets/orbiq-mark.png" Width="54" Height="54" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Image x:Name="BubbleImage" Width="60" Height="60" Stretch="UniformToFill"
                       Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Border>

        <Border x:Name="Panel" Width="850" Height="670" CornerRadius="22"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="0.05" ScaleY="0.05" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.40" />
            </Border.Effect>
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="WelcomeTextBlock" Text="Приятного использования" Foreground="{DynamicResource TextBrush}"
                                   FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="WelcomeSubtitleText" Text="Orbiq — твоя небольшая многофункциональная панель" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" Margin="1,5,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="CollapseButton" Content="—" Width="34" Height="32" Margin="3,0" Click="Collapse_Click"
                                ToolTip="Свернуть в кружок" Style="{StaticResource ActionButtonStyle}" Padding="0" />
                        <Button x:Name="TrayButton" Content="○" Width="34" Height="32" Margin="3,0" Click="HideToTray_Click"
                                ToolTip="Скрыть в системный трей" Style="{StaticResource ActionButtonStyle}" Padding="0" />
                        <Button x:Name="CloseButton" Content="×" Width="34" Height="32" Margin="3,0" Click="ClosePrompt_Click"
                                ToolTip="Закрыть приложение" Style="{StaticResource ActionButtonStyle}" Padding="0"
                                Background="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Button x:Name="ClockNavButton" Content="◷   Часы" Tag="Clock" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button x:Name="NotesNavButton" Content="▤   Заметки" Tag="Notes" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button x:Name="CalculatorNavButton" Content="＋   Калькулятор" Tag="Calculator" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button x:Name="ConverterNavButton" Content="⇄   Конвертер" Tag="Converter" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button x:Name="RemindersNavButton" Content="◷   Напоминания" Tag="Reminders" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button x:Name="PomodoroNavButton" Content="◉   Pomodoro" Tag="Pomodoro" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button x:Name="CalendarNavButton" Content="▦   Календарь" Tag="Calendar" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button x:Name="MonitorNavButton" Content="▥   Мониторинг" Tag="Monitor" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="5,10,5,10" />
                            <Button x:Name="SettingsNavButton" Content="⚙   Настройки" Tag="Settings" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}" />
                            <TextBlock x:Name="BrandFooterText" Text="ORBIQ  •  PERSONAL" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="14,8,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Width="1" HorizontalAlignment="Center" />
                    <ContentControl x:Name="ContentArea" Grid.Column="2" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="DialogOverlay" Grid.Row="0" Panel.ZIndex="50" CornerRadius="18"
                Background="#B80A111D" Visibility="Collapsed" Padding="18">
            <Border x:Name="DialogCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="24" Width="490" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="Сообщение" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextAlignment="Center" />
                    <TextBlock x:Name="DialogMessage" Text="" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="DialogAcceptButton" Content="Хорошо" Click="DialogAccept_Click"
                                Style="{StaticResource ActionButtonStyle}" Background="{DynamicResource AccentBrush}" MinWidth="105" />
                        <Button x:Name="DialogCancelButton" Content="Отмена" Click="DialogCancel_Click"
                                Style="{StaticResource ActionButtonStyle}" MinWidth="105" />
                        <Button x:Name="DialogThirdButton" Content="Удалить всё" Click="DialogThird_Click"
                                Style="{StaticResource ActionButtonStyle}" Background="{DynamicResource DangerBrush}"
                                MinWidth="115" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
